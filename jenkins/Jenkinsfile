
pipeline {
    agent {
        label 'ubuntu'
    }

    tools {
        maven 'maven-3.9.12'
    }

    stages {
        stage('Check Maven and Java') {
            steps {
                sh '''
                    java -version
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                sh 'mvn -B -DskipTests clean package'
            }
        }
    }
}
